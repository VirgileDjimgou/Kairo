# Copy to .env.core on the cloud server. Never commit the copied file.
APP_ENV=production
APP_DEBUG=false
# White-label tenant domains: direct subdomains of this base resolve to tenant
# slugs (for example combis.kairo.example). Exact tenant custom domains are
# configured per tenant in the settings branding. Leave empty to disable.
PLATFORM_BASE_DOMAIN=
# Reliability: seconds a worker may hold an outbox event before another worker
# reclaims it after a crash. Default 300.
OUTBOX_PROCESSING_LEASE_SECONDS=300
APP_BASE_URL=https://kairo.patrickdjimgou.dev
CORS_ORIGINS=https://kairo.patrickdjimgou.dev
# Absolute paths on a release host keep operational data outside versioned code.
BACKUP_HOST_DIR=/home/kairo/shared/backups
PRIVATE_SECRETS_DIR=/home/kairo/shared/private
JWT_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=orgmind
POSTGRES_USER=orgmind
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://orgmind:replace-with-a-strong-password@postgres:5432/orgmind
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=orgmind
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://kairo.patrickdjimgou.dev
MINIO_BUCKET_DOCUMENTS=documents
# The portfolio core runs without the optional inference runtime. Enable the
# remote mode only when a separately secured AI runtime is available.
AI_RUNTIME_MODE=disabled
LLM_PROVIDER_KIND=remote_ai_runtime
EMBEDDING_PROVIDER_KIND=remote_ai_runtime
AI_GATEWAY_BASE_URL=
AI_GATEWAY_SHARED_SECRET=
# Optional but recommended when the AI tunnel hostname is protected by Cloudflare Access.
AI_GATEWAY_ACCESS_CLIENT_ID=
AI_GATEWAY_ACCESS_CLIENT_SECRET=
AI_GATEWAY_REQUEST_TTL_SECONDS=60
AI_EMBEDDING_PROFILE=nomic-embed-text-v1
EMBEDDING_DIMENSIONS=768
INGESTION_AUTO_ENQUEUE=false
INDEXING_AUTO_ENABLED=false
VITE_API_BASE_URL=/api/v1
# Public portfolio demo. Set VITE_DEMO_MODE=false to disable it. Provide
# VITE_DEMO_ACCOUNTS (JSON array) when the live demo credentials differ from
# the seed accounts, so the one-click demo entry point keeps working.
VITE_DEMO_MODE=true
VITE_DEMO_TENANT_SLUG=demo
VITE_DEMO_ACCOUNTS=
# Base64-encoded JSON array of demo accounts. Use this instead of
# VITE_DEMO_ACCOUNTS when the passwords contain characters that are awkward in
# an env file (it is also what a rotated portfolio deployment uses).
VITE_DEMO_ACCOUNTS_B64=
# Firebase Web configuration for FCM background notifications. These are public
# client identifiers (never service-account keys). Leave empty to keep FCM
# disabled; standards-based Web Push (VAPID) still works.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
# Optional Firebase Web Push certificate key for FCM web token registration.
VITE_FIREBASE_VAPID_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@example.org
# Encrypted recovery archives. Generate a Fernet key and a separate long
# signing secret, then retain both outside of the backup destination.
BACKUP_ENABLED=true
BACKUP_AUTO_ENABLED=true
BACKUP_STORAGE_DIR=/var/backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=replace-with-a-fernet-key
BACKUP_MANIFEST_SIGNING_KEY=replace-with-a-separate-long-random-secret
BACKUP_PITR_ENABLED=true
# Optional external S3-compatible destination. Archives are already encrypted
# before upload; leave blank until a remote bucket and credentials are ready.
BACKUP_EXTERNAL_S3_ENDPOINT=
BACKUP_EXTERNAL_S3_BUCKET=
BACKUP_EXTERNAL_S3_ACCESS_KEY=
BACKUP_EXTERNAL_S3_SECRET_KEY=
