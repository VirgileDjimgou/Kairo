{
  "name": "kairo-root",
  "version": "2.0.0",
  "private": true,
  "description": "Kairo repository root automation (sprint batch autopilot). Application packages live in apps/web and services/api.",
  "scripts": {
    "sprint:batch:start": "node scripts/sprint-batch/cli.mjs start",
    "sprint:batch:status": "node scripts/sprint-batch/cli.mjs status",
    "sprint:batch:resume": "node scripts/sprint-batch/cli.mjs resume",
    "sprint:batch:stop": "node scripts/sprint-batch/cli.mjs stop",
    "sprint:batch:doctor": "node scripts/sprint-batch/cli.mjs doctor",
    "sprint:batch:report": "node scripts/sprint-batch/cli.mjs report",
    "sprint:batch:pause": "node scripts/sprint-batch/cli.mjs pause",
    "sprint:batch:pause-human": "node scripts/sprint-batch/cli.mjs pause-human",
    "sprint:batch:reset": "node scripts/sprint-batch/cli.mjs reset",
    "sprint:batch:preflight": "node scripts/sprint-batch/cli.mjs preflight",
    "sprint:batch:handoff": "node scripts/sprint-batch/cli.mjs handoff",
    "sprint:batch:repair": "node scripts/sprint-batch/cli.mjs repair",
    "sprint:batch:dry-run": "node scripts/sprint-batch/cli.mjs start --dry-run",
    "sprint:batch:test": "node --test scripts/sprint-batch/sprint-batch.test.mjs",
    "sprint:next": "node scripts/sprint-batch/cli.mjs next",
    "notifications:firebase:doctor": "node scripts/notifications-firebase-doctor.mjs",
    "openapi:update": "node scripts/check-openapi-contract.mjs --update",
    "contracts:generate": "node scripts/generate-client-contracts.mjs",
    "contracts:check": "node scripts/check-openapi-contract.mjs && node scripts/generate-client-contracts.mjs --check && node scripts/check-client-route-coverage.mjs",
    "perf:baseline": "node scripts/run-performance-baseline.mjs",
    "perf:check": "node scripts/check-performance-regression.mjs"
  }
}
