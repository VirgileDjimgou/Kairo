# Secrets and private operational material must never enter a build context.
.private/
.env
.env.*

# Local databases, dumps, backups and logs
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup
*.log
tmp/

# Caches and generated artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Tests are not needed in production images (the dev target mounts the source).
tests/
