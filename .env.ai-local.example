# Copy to .env.ai-local on the home machine. This file is private.
AI_GATEWAY_SHARED_SECRET=replace-with-the-same-long-secret-as-the-cloud-runtime
AI_GATEWAY_REQUEST_TTL_SECONDS=60
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=orgmind_document_chunks
EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_PROFILE=nomic-embed-text-v1
AI_CLOUDFLARE_TUNNEL_TOKEN=
